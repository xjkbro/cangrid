# Copy to .env and fill in with real values. There is no local/throwaway
# database or storage in this project — dev and production both connect to
# the self-hosted MariaDB and MinIO instances (see GitHub issues #1 and #2).

# --- Database (ticket #1) ---
# Connection string for the self-hosted MariaDB instance.
DATABASE_URL="mysql://<user>:<password>@<host>:<port>/<database>"

# --- Object storage (ticket #2) ---
# Connection details for the self-hosted MinIO instance (the Dokploy-managed
# service you already have running).
MINIO_ENDPOINT="<minio-host>:<port>"
# Public-facing host used to build URLs served to browsers/next/image, if
# different from MINIO_ENDPOINT (e.g. an internal hostname vs. a public
# domain). Falls back to MINIO_ENDPOINT when unset.
# MINIO_PUBLIC_URL=
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET=""
MINIO_USE_SSL="true"

# --- Auth (ticket #3) ---
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET=""

# --- Email (ticket #4) ---
# RESEND_API_KEY=""
# FROM_EMAIL=""

# --- Google OAuth (ticket #3, scaffolded but disabled) ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
